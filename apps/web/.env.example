# Copy to apps/web/.env and fill in real values (the .env itself is git-ignored).

# Absolute path to the shared SQLite database file (same file the worker uses).
# Default matches the recommended Pi deployment layout (see README); point it
# elsewhere for local development.
DB_PATH=/opt/screen-time/data/screen-time.sqlite

# Household IANA timezone used to evaluate schedule windows and format times.
TIMEZONE=America/Toronto
