# screen-time-web.service — systemd unit for the SvelteKit web app (adapter-node).
#
# Expected install layout on the Raspberry Pi (see README "Deploying on the
# Raspberry Pi"): same as the worker unit — dedicated `screen-time` system
# user, repo at /opt/screen-time, built once with `pnpm install && pnpm run
# build` (produces the standalone server at /opt/screen-time/apps/web/build).
# The app reads apps/web/.env itself at startup; no EnvironmentFile= needed.
#
# BEFORE INSTALLING: set ORIGIN below to the exact URL the app is reached at
# (scheme, host, and port if non-default — e.g. http://screen-time.example.com,
# resolving via a local DNS record on the gateway; see README). SvelteKit
# checks form POSTs (the override buttons) against this origin and rejects
# them with a 403 if it is wrong or unset.
#
# Install:
#   sudo cp /opt/screen-time/apps/web/screen-time-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now screen-time-web
# Logs:
#   journalctl -u screen-time-web -f

[Unit]
Description=Household screen time web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=screen-time
WorkingDirectory=/opt/screen-time/apps/web
Environment=PORT=80
Environment=ORIGIN=http://CHANGE-ME
# Port 80 is privileged; grant the non-root service user just the capability
# to bind it (no root, no reverse proxy needed).
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/node /opt/screen-time/apps/web/build
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
