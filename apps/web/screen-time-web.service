# screen-time-web.service — systemd unit for the SvelteKit web app (adapter-node).
#
# Expected install layout on the Raspberry Pi (see README "Deploying on the
# Raspberry Pi"): same as the worker unit — dedicated `screen-time` system
# user, repo at /opt/screen-time, built once with `pnpm install && pnpm run
# build` (produces the standalone server at /opt/screen-time/apps/web/build).
# The app reads apps/web/.env itself at startup; no EnvironmentFile= needed.
#
# The app is published to the internet through Cloudflare Tunnel + Cloudflare
# Access (see README "Publishing the app with Cloudflare Tunnel"), so it listens
# on loopback only: the tunnel connector on the same host is its sole client.
# That is deliberate — authentication is enforced at the Cloudflare edge and the
# app itself has none, so a port open to the LAN would be an unauthenticated way
# around it.
#
# BEFORE INSTALLING: set ORIGIN below to the exact public URL the app is browsed
# at — https:// plus the Cloudflare hostname, e.g.
# https://screen-time.example.com — with no trailing slash and no path.
# SvelteKit checks form POSTs (the override buttons) against this origin and
# rejects them with a 403 if it is wrong or unset.
#
# Install:
#   sudo cp /opt/screen-time/apps/web/screen-time-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now screen-time-web
# Logs:
#   journalctl -u screen-time-web -f

[Unit]
Description=Household screen time web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=screen-time
WorkingDirectory=/opt/screen-time/apps/web
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=ORIGIN=https://CHANGE-ME
ExecStart=/usr/bin/node /opt/screen-time/apps/web/build
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
