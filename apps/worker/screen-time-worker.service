# screen-time-worker.service — systemd unit for the reconcile worker.
#
# Expected install layout on the Raspberry Pi (see README "Deploying the worker"):
#   - Dedicated system user `screen-time` owning the checkout and the database
#   - Repo checked out at /opt/screen-time
#   - Built once with: pnpm install && pnpm run build
#     (produces /opt/screen-time/apps/worker/dist/index.js)
#   - Env file at /opt/screen-time/apps/worker/.env (copy .env.example)
#
# Using a different location or user? The User= line and the three absolute
# paths below (WorkingDirectory=, EnvironmentFile=, ExecStart=) are the only
# things to change — edit them before copying this file into /etc/systemd/system.
#
# Install:
#   sudo cp /opt/screen-time/apps/worker/screen-time-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now screen-time-worker
# Logs:
#   journalctl -u screen-time-worker -f

[Unit]
Description=Household screen time reconcile worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=screen-time
WorkingDirectory=/opt/screen-time/apps/worker
EnvironmentFile=/opt/screen-time/apps/worker/.env
ExecStart=/usr/bin/node /opt/screen-time/apps/worker/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
