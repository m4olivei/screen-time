# screen-time-worker.service — systemd unit for the reconcile worker.
#
# Expected install layout on the Raspberry Pi:
#   - Repo checked out at /home/pi/screen-time
#   - Built once with: pnpm install && pnpm run build
#     (produces /home/pi/screen-time/apps/worker/dist/index.js)
#   - Env file at /home/pi/screen-time/apps/worker/.env (copy .env.example)
#
# Install:
#   sudo cp /home/pi/screen-time/apps/worker/screen-time-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now screen-time-worker
# Logs:
#   journalctl -u screen-time-worker -f

[Unit]
Description=Household screen time reconcile worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/screen-time/apps/worker
EnvironmentFile=/home/pi/screen-time/apps/worker/.env
ExecStart=/usr/bin/node /home/pi/screen-time/apps/worker/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
