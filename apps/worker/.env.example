# apps/worker environment — copy this file to apps/worker/.env (git-ignored)
# and fill in real values. The worker loads .env from this package directory
# regardless of cwd; under systemd the same file is passed via EnvironmentFile=.
#
# Note: there is NO policy-ID variable here. The UniFi firewall policy ID for
# each profile lives in the database (Profile.unifiRuleId), not in env.

# Base UniFi gateway URL, no trailing slash, e.g. https://192.168.1.1
UNIFI_GATEWAY_URL=https://192.168.1.1

# API key generated in the UniFi console (Settings -> Control Plane -> Integrations)
UNIFI_API_KEY=your-unifi-api-key

# Site ID from the Integration API (GET /v1/sites)
UNIFI_SITE_ID=00000000-0000-0000-0000-000000000000

# Absolute path to the shared SQLite database file (same file the web app uses).
# Default matches the recommended Pi deployment layout (repo at /opt/screen-time,
# owned by the screen-time service user — see README).
DB_PATH=/opt/screen-time/data/screen-time.sqlite

# Household IANA timezone used to evaluate schedule windows
TIMEZONE=America/Toronto

# Milliseconds between reconcile ticks (default 5000 when unset)
TICK_INTERVAL_MS=5000

# --- Pre-cutoff warning notifications (both OPTIONAL) ------------------------
# Each transport is disabled when its variable is unset or empty, and the
# worker enforces the schedule exactly as before. Startup logs which are live:
#   notifications: tvoverlay=active|inactive ntfy=active|inactive
# Leave these commented out until the real endpoints exist.

# Full ntfy topic URL for laptops/phones. The topic name is the ONLY access
# control on ntfy.sh and it grants publish as well as subscribe, so generate a
# high-entropy one (`echo "screen-time-$(openssl rand -hex 8)"`), treat it as a
# secret, and never derive it from the household domain. See README.
#NTFY_TOPIC_URL=https://ntfy.sh/screen-time-0123456789abcdef

# Base URL of the TvOverlay app on the TV, no trailing slash and no path — the
# client appends /notify itself. Use the TV's DHCP-reserved LAN address.
#TVOVERLAY_URL=http://192.168.1.50:5001
