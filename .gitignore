.idea

# Self-review scratch files (may contain secrets pasted into comments)
review.xml
review.guide.xml

# Local environment files (secrets) — committed specs live in .env.example
.env
.env.*
!.env.example

# OpenTofu (infra/cloudflare): local state holds the tunnel token and secret and
# the Google OAuth client secret; tfvars holds the household emails and account
# IDs. Committed specs live in terraform.tfvars.example. Note .terraform.lock.hcl
# IS committed — it contains no secrets and pins provider versions.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/*.tfvars
!infra/**/*.tfvars.example
infra/**/.terraform.tfstate.lock.info
infra/**/crash*.log

# Dependencies
node_modules/

# Build output
dist/
build/
.svelte-kit/
.output/
.vercel/

# Misc
*.log
.DS_Store
vite.config.ts.timestamp-*

# Pi deployment: the SQLite database lives in data/ (default DB_PATH), and the
# screen-time service user's HOME is the checkout (/opt/screen-time), so tool
# dotfiles (pnpm/corepack/npm caches, shell histories) land in the repo root.
/data/
/.cache/
/.local/
/.npm/
/.bash_history
/.sqlite_history
/.viminfo
