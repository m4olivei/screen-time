# UniFi Integration API configuration (used by scripts/toggle-proof.ts)
# Copy this file to .env (git-ignored) and fill in the values.

# Base gateway URL, no trailing slash, e.g. https://192.168.1.1
UNIFI_GATEWAY_URL=

# API key generated in the UniFi console (Settings -> Control Plane -> Integrations)
UNIFI_API_KEY=

# Site ID from GET /v1/sites (leave empty to have the proof script list sites)
UNIFI_SITE_ID=

# ID of the manually created Kids-network block policy
# (leave empty to have the proof script list firewall policies)
UNIFI_POLICY_ID=
